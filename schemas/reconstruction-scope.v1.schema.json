{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contractility.reconstruction-scope.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseContract", "instruments"],
  "properties": {
    "schemaVersion": {
      "const": "contractility.reconstruction-scope.v1"
    },
    "baseContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDocumentId",
        "number",
        "date",
        "page",
        "evidence"
      ],
      "properties": {
        "sourceDocumentId": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceDocumentId",
          "pages",
          "agreementNumber",
          "agreementDate",
          "referencedContractNumber",
          "referencedContractDate",
          "decision",
          "reason"
        ],
        "properties": {
          "sourceDocumentId": {
            "type": "string",
            "minLength": 1
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "agreementNumber": {
            "type": "string",
            "minLength": 1
          },
          "agreementDate": {
            "type": "string",
            "minLength": 1
          },
          "referencedContractNumber": {
            "type": "string",
            "minLength": 1
          },
          "referencedContractDate": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": ["included", "excluded"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
