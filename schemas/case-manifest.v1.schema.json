{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contractility.case-manifest.v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "caseId",
    "createdAt",
    "formationRequest",
    "signedDocuments",
    "newAgreementEdition"
  ],
  "properties": {
    "schemaVersion": {
      "const": "contractility.case-manifest.v1"
    },
    "caseId": {
      "type": "string"
    },
    "formationRequest": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ]
    },
    "signedDocuments": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "order",
          "path",
          "sha256",
          "originalName"
        ]
      }
    },
    "newAgreementEdition": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "path",
        "sha256",
        "originalName"
      ]
    },
    "workflowStage": {
      "enum": [
        "full",
        "master",
        "agreement"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "workflowStage": {
            "const": "master"
          }
        },
        "required": [
          "workflowStage"
        ]
      },
      "then": {
        "properties": {
          "newAgreementEdition": {
            "type": "null"
          },
          "signedDocuments": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "newAgreementEdition": {
            "type": "object"
          }
        }
      }
    }
  ]
}
