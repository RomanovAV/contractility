{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contractility.master-contract.v1",
  "type": "object",
  "required": ["schemaVersion", "createdAt", "payload", "sha256", "approval"],
  "properties": {
    "schemaVersion": { "const": "contractility.master-contract.v1" },
    "createdAt": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "payload": {
      "type": "object",
      "required": ["currentContract", "reconstructionScope", "signedDocuments", "review"],
      "properties": {
        "currentContract": { "type": "string", "minLength": 100 },
        "reconstructionScope": { "$ref": "reconstruction-scope.v1.schema.json" },
        "signedDocuments": { "type": "array", "minItems": 1 },
        "humanRevisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["schemaVersion", "revisedAt", "sourceFileName", "previousTargetSha256", "currentTargetSha256", "previousMasterSha256"],
            "properties": {
              "schemaVersion": { "const": "contractility.master-human-revision.v1" },
              "revisedAt": { "type": "string", "format": "date-time" },
              "sourceFileName": { "type": "string", "minLength": 1 },
              "previousTargetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "currentTargetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "previousMasterSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "review": {
          "type": "object",
          "required": ["schemaVersion", "reviewedAt", "targetSha256", "evidenceManifestSha256", "findingsSha256", "reports"],
          "properties": {
            "schemaVersion": { "const": "contractility.master-review.v1" },
            "reviewedAt": { "type": "string", "format": "date-time" },
            "round": { "type": "integer", "minimum": 1 },
            "targetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "evidenceManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "findingsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "reports": {
              "type": "array",
              "minItems": 3,
              "items": { "$ref": "review-report.v1.schema.json" }
            },
            "consensus": { "type": "object" },
            "actionItems": { "type": "array", "maxItems": 10 },
            "actionItemCount": { "type": "integer", "minimum": 0 },
            "blockingActionItemCount": { "type": "integer", "minimum": 0 },
            "advisoryActionItemCount": { "type": "integer", "minimum": 0 },
            "reviewCompletion": { "enum": ["automatic-complete", "complete-with-advisories", "manual-resolution-required"] },
            "omittedActionItemCount": { "type": "integer", "minimum": 0 },
            "history": { "type": "array", "minItems": 1 }
          }
        }
      }
    },
    "approval": {
      "type": ["object", "null"],
      "required": ["approver", "approvedAt", "sha256"],
      "properties": {
        "approver": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "acknowledgedFindings": { "type": "boolean" }
      }
    }
  }
}
