{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contractility.master-contract.v1",
  "type": "object",
  "required": ["schemaVersion", "createdAt", "payload", "sha256", "approval"],
  "properties": {
    "schemaVersion": { "const": "contractility.master-contract.v1" },
    "createdAt": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "payload": {
      "type": "object",
      "required": ["currentContract", "reconstructionScope", "signedDocuments"],
      "properties": {
        "currentContract": { "type": "string", "minLength": 100 },
        "reconstructionScope": { "$ref": "reconstruction-scope.v1.schema.json" },
        "signedDocuments": { "type": "array", "minItems": 1 }
      }
    },
    "approval": {
      "type": ["object", "null"],
      "required": ["approver", "approvedAt", "sha256"],
      "properties": {
        "approver": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
